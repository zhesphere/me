---
import { getBlogItems } from "../lib/blog";
import { siteConfig, validateSiteConfig } from "../data/site";
import "../styles/global.css";

const configErrors = validateSiteConfig(siteConfig);
if (configErrors.length) throw new Error(`Invalid site configuration: ${configErrors.join(", ")}`);

const { items: feedItems, source: blogSource } = await getBlogItems(siteConfig.blogFeedUrl);
const blogItems = feedItems.slice(0, 3);
const publishedYear = new Date().getFullYear();
const formatDate = (value: string) => {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "最近更新";
  return new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
};
const creates = [
  {
    key: "hardware",
    title: "硬件系统",
    description: "让想法拥有可触摸的起点，把电路与结构做成可验证的原型。",
    hint: "Hardware"
  },
  {
    key: "software",
    title: "软件构建",
    description: "把复杂世界整理成清晰体验，用代码收束流程与界面。",
    hint: "Software"
  },
  {
    key: "ai",
    title: "AI 探索",
    description: "与新的工具共同试探边界，记录可用的方法与失败。",
    hint: "AI"
  },
  {
    key: "design",
    title: "产品设计",
    description: "让技术带着情绪自然抵达，重视手感、节奏与可读性。",
    hint: "Design"
  }
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  sameAs: siteConfig.socialLinks.map((link) => link.href),
  description: siteConfig.description
};
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="theme-color" name="theme-color" content="#f4f7fc" />
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={`${siteConfig.name} · Personal Universe`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={siteConfig.siteUrl} />
    <meta property="og:image" content={`${siteConfig.siteUrl}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} · Personal Universe`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}/og.png`} />
    <link rel="canonical" href={siteConfig.siteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} · Personal Universe</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("orbitvo-theme");
        if (savedTheme === "dark") {
          document.documentElement.dataset.theme = "dark";
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#0c121c");
        }
      } catch {}
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"></div>

    <header class="site-header shell">
      <a class="brand" href="#top" aria-label="返回 Orbitvo 首页顶部">
        <span class="brand-mark" aria-hidden="true"></span><span>orbitvo</span>
      </a>
      <nav class="nav-links" aria-label="页内导航">
        <a href="#creates">创造</a>
        <a href="#writing">文章</a>
        <a href="#about">关于</a>
      </nav>
      <div class="nav-actions">
        <button class="theme-toggle" type="button" aria-label="切换至深色模式" title="切换至深色模式">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" /><circle cx="10" cy="10" r="3.2" /></svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.2 12.4A6.6 6.6 0 0 1 7.6 3.8a6.6 6.6 0 1 0 8.6 8.6Z" /></svg>
        </button>
        <a class="nav-blog" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">Blog <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg></a>
      </div>
    </header>

    <main id="top">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-identity">ZheSphere · Personal Universe</p>
          <h1 id="hero-title">ORBITVO</h1>
          <p class="hero-statement">把未成形的好奇，做成能抵达的东西。</p>
          <p class="hero-lede">硬件、软件、AI 与设计交界处的工作笔记——真实试验，不编造履历。</p>
          <div class="hero-actions">
            <a class="primary-link" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">
              阅读博客
              <span aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg></span>
            </a>
            <a class="secondary-link" href="https://github.com/zhesphere" target="_blank" rel="noreferrer">
              GitHub <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg>
            </a>
          </div>
        </div>

        <div class="hero-art" aria-label="折纸航图：硬件、软件、AI 与设计四条航线">
          <svg class="transit-chart" viewBox="0 0 440 440" role="img" aria-label="Folded Transit 航图面板">
            <defs>
              <linearGradient id="fold-a" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#9ec4f5" stop-opacity="0.55" />
                <stop offset="100%" stop-color="#3d7be0" stop-opacity="0.12" />
              </linearGradient>
              <linearGradient id="fold-b" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#c9ddf8" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#2459b5" stop-opacity="0.1" />
              </linearGradient>
              <filter id="node-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
              </filter>
            </defs>
            <rect class="chart-plate" x="28" y="36" width="384" height="368" rx="28" />
            <path class="fold-plane fold-1" d="M48 70 220 110 220 300 48 250Z" fill="url(#fold-a)" />
            <path class="fold-plane fold-2" d="M220 110 392 78 392 250 220 300Z" fill="url(#fold-b)" />
            <path class="fold-plane fold-3" d="M48 250 220 300 220 380 72 348Z" fill="url(#fold-b)" opacity="0.7" />
            <path class="fold-plane fold-4" d="M220 300 392 250 368 360 220 380Z" fill="url(#fold-a)" opacity="0.65" />
            <path class="fold-crease" d="M220 110V380M48 250 392 250" />
            <path class="transit-path" pathLength="1" d="M96 168C150 140 190 190 220 220C255 255 300 210 344 188" />
            <path class="transit-path transit-path-b" pathLength="1" d="M110 300C160 270 190 290 220 300C260 312 310 290 340 270" />
            <g class="transit-nodes" filter="url(#node-glow)">
              <g class="transit-node node-hw" transform="translate(96 168)">
                <circle r="9" /><circle class="node-ring" r="16" /><text y="36">硬件</text>
              </g>
              <g class="transit-node node-sw" transform="translate(220 220)">
                <circle r="10" /><circle class="node-ring" r="18" /><text y="38">软件</text>
              </g>
              <g class="transit-node node-ai" transform="translate(344 188)">
                <circle r="9" /><circle class="node-ring" r="16" /><text y="36">AI</text>
              </g>
              <g class="transit-node node-ds" transform="translate(220 300)">
                <circle r="9" /><circle class="node-ring" r="16" /><text y="36">设计</text>
              </g>
            </g>
            <text class="chart-caption" x="52" y="58">TRANSIT / 01</text>
            <text class="chart-caption chart-caption-end" x="388" y="386">UNFORMED → ARRIVAL</text>
          </svg>
          <p class="art-note"><span>FOLDED TRANSIT</span><strong>Hardware · Software · AI · Design</strong></p>
        </div>
        <a class="explore-cue" href="#creates">继续探索 <span aria-hidden="true"></span></a>
      </section>

      <section class="creates section shell" id="creates" aria-labelledby="creates-title">
        <header class="section-heading">
          <div>
            <h2 id="creates-title">四条仍在飞的航线。</h2>
            <p class="section-lede">不是履历墙——是下一步试验还在推进的四个方向。</p>
          </div>
        </header>
        <div class="create-grid" id="coordinates" aria-label="个人创造方向">
          {creates.map((item) => (
            <article class={`create-card create-${item.key}`}>
              <div class="create-visual" aria-hidden="true">
                <span class="create-glow"></span>
                <span class="create-hint">{item.hint}</span>
              </div>
              <div class="create-copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="writing section shell" id="writing" aria-labelledby="writing-title">
        <header class="section-heading">
          <div>
            <h2 id="writing-title">刚写下的信号。</h2>
            <p class="section-lede">来自博客的最新记录，标题优先，日期退居其次。</p>
          </div>
          <a class="section-link" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">
            查看全部文章 <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg>
          </a>
        </header>

        <div class="article-grid">
          {blogItems.map((article, index) => (
            <a class={`article-card article-tone-${index + 1}`} href={article.href} target="_blank" rel="noreferrer">
              <div class="article-visual">
                <span class="article-index">0{index + 1}</span>
                <span class="article-arrow" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg></span>
                <span class="article-orbit orbit-a" aria-hidden="true"></span>
                <span class="article-orbit orbit-b" aria-hidden="true"></span>
                <div class="article-signal" aria-hidden="true">
                  <small>SIGNAL</small>
                  <b>{article.title.slice(0, 18)}</b>
                  <i></i>
                </div>
              </div>
              <div class="article-copy">
                <div>
                  <h3>{article.title}</h3>
                  {article.summary && <p>{article.summary}</p>}
                </div>
                <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
              </div>
            </a>
          ))}
        </div>
        <p class="feed-source">FEED SOURCE / {blogSource.toUpperCase()}</p>
      </section>

      <section class="about section shell" id="about" aria-labelledby="about-title">
        <div class="about-panel">
          <h2 id="about-title">你好，我是 ZheSphere——在交界处把好奇<em>做成东西。</em></h2>
          <p>硬件工程师，也写软件、做设计、试 AI。Orbitvo 收集真实工作与试验留下的坐标，不是一份包装过的履历。</p>
          <div class="about-actions">
            <a class="primary-link" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">
              去博客看看
              <span aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg></span>
            </a>
            <a class="secondary-link" href="https://github.com/zhesphere" target="_blank" rel="noreferrer">
              GitHub <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg>
            </a>
          </div>
        </div>
      </section>

      <section class="journal section shell" aria-labelledby="journal-title">
        <a href={siteConfig.blogUrl} target="_blank" rel="noreferrer">
          <span>CONTINUE EXPLORING</span>
          <h2 id="journal-title">下一站，在博客里。</h2>
          <i aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg></i>
        </a>
      </section>
    </main>

    <footer class="site-footer shell">
      <p>有一些新的信号？</p>
      <a class="footer-blog" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">
        去博客看看。<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5m0 0H7m8 0v8" /></svg>
      </a>
      <div class="footer-meta">
        <span>© {publishedYear} ZHESPHERE</span>
        <span>用电路、代码、光线与好奇心制作</span>
        <p>
          <a href={siteConfig.blogUrl} target="_blank" rel="noreferrer">Blog</a>
          <a href="https://github.com/zhesphere" target="_blank" rel="noreferrer">GitHub</a>
          <a href={siteConfig.blogFeedUrl} target="_blank" rel="noreferrer">RSS</a>
          <a href="#top">Top ↑</a>
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const themeColor = document.querySelector<HTMLMetaElement>("#theme-color");
      const currentTheme = () => (root.dataset.theme === "dark" ? "dark" : "light");
      function updateToggle() {
        if (!toggle) return;
        const dark = currentTheme() === "dark";
        const label = dark ? "切换至浅色模式" : "切换至深色模式";
        toggle.setAttribute("aria-label", label);
        toggle.title = label;
        themeColor?.setAttribute("content", dark ? "#0c121c" : "#f4f7fc");
      }
      toggle?.addEventListener("click", () => {
        const nextTheme = currentTheme() === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
        try {
          localStorage.setItem("orbitvo-theme", nextTheme);
        } catch {}
        updateToggle();
      });
      updateToggle();
    </script>
  </body>
</html>
