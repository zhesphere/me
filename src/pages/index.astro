---
import { getBlogItems } from "../lib/blog";
import { siteConfig, validateSiteConfig } from "../data/site";
import "../styles/global.css";

const configErrors = validateSiteConfig(siteConfig);
if (configErrors.length) throw new Error(`Invalid site configuration: ${configErrors.join(", ")}`);

const { items: blogItems, source: blogSource } = await getBlogItems(siteConfig.blogFeedUrl);
const publishedYear = new Date().getFullYear();
const formatDate = (value: string) => {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "NEW SIGNAL";
  return new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  sameAs: siteConfig.socialLinks.map((link) => link.href),
  description: siteConfig.description
};
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070a12" />
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={`${siteConfig.name} · Personal Universe`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={siteConfig.siteUrl} />
    <meta property="og:image" content={`${siteConfig.siteUrl}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} · Personal Universe`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}/og.png`} />
    <link rel="canonical" href={siteConfig.siteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{siteConfig.name} · Personal Universe</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <canvas id="starfield" aria-hidden="true"></canvas>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>
    <div class="speed-lines" aria-hidden="true"></div>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="返回主页顶部">
        <span class="wordmark-mark" aria-hidden="true"></span>
        <span>ORBITVO <small>／ ZHESPHERE</small></span>
      </a>
      <p class="system-state"><span></span> SYSTEM ONLINE</p>
    </header>

    <main id="top">
      <section class="universe" aria-labelledby="hero-title">
        <div class="coordinate coordinate-nw" aria-hidden="true">31°14′N / 121°28′E</div>
        <div class="coordinate coordinate-se" aria-hidden="true">SECTOR / A-01</div>

        <div class="orbital-system">
          <div class="orbit orbit-outer" aria-hidden="true"></div>
          <div class="orbit orbit-middle" aria-hidden="true"></div>
          <div class="orbit orbit-inner" aria-hidden="true"></div>

          <div class="core">
            <div class="core-sun" aria-hidden="true"><i></i><b></b><em></em></div>
            <p class="kicker">ZHESPHERE'S PERSONAL UNIVERSE</p>
            <h1 id="hero-title"><span>ORBITVO</span></h1>
            <p class="tagline">{siteConfig.tagline}</p>
            <div class="core-axis" aria-hidden="true"><i></i><i></i></div>
          </div>

          {siteConfig.portals.map((portal) => (
            <div class={`orbiter orbiter-${portal.id}`}>
              <a
                class="portal-node"
                href={portal.href ?? `#panel-${portal.id}`}
                data-panel={portal.href ? undefined : portal.id}
                target={portal.href ? "_blank" : undefined}
                rel={portal.href ? "noreferrer" : undefined}
                aria-controls={portal.href ? undefined : `panel-${portal.id}`}
                aria-expanded={portal.href ? undefined : "false"}
              >
                <span class="node-beacon" aria-hidden="true"><i></i></span>
                <span class="node-copy">
                  <small>{portal.index} / {portal.eyebrow}</small>
                  <strong>{portal.label}</strong>
                  <em>{portal.description}</em>
                </span>
              </a>
            </div>
          ))}
        </div>

        <p class="scroll-note"><span aria-hidden="true">↳</span> SELECT A SIGNAL TO EXPLORE</p>
      </section>

      <section class="fallback-content" aria-label="个人信息与链接">
        <article class="fallback-card">
          <p>01 / BLOG · SIGNAL</p>
          <h2>来自博客的最新信号</h2>
          {blogItems.length ? (
            <ul>
              {blogItems.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
            </ul>
          ) : (
            <p>最新文章正在穿越星际网络。</p>
          )}
          <a class="text-link" href={siteConfig.blogUrl}>进入博客 →</a>
        </article>
        <article class="fallback-card">
          <p>02 / GITHUB · SOURCE</p>
          <h2>公开代码与实验轨迹</h2>
          <a class="text-link" href="https://github.com/zhesphere">访问 GitHub →</a>
        </article>
        <article class="fallback-card">
          <p>03 / ABOUT · ORIGIN</p>
          <h2>你好，我是 ZheSphere。</h2>
          <p>这里是我记录技术、创造与想象的坐标原点。</p>
        </article>
      </section>
    </main>

    <div class="veil" data-close-panel aria-hidden="true"></div>

    <aside class="panel-shell" id="panel-blog" data-panel-content="blog" aria-labelledby="panel-blog-title" aria-hidden="true" tabindex="-1">
      <button class="panel-close" type="button" data-close-panel aria-label="关闭博客面板">CLOSE <span>×</span></button>
      <div class="panel-index">01</div>
      <p class="panel-kicker">INCOMING TRANSMISSIONS</p>
      <h2 id="panel-blog-title">最新信号</h2>
      <p class="panel-lede">来自 <span>blog.zsphere.top</span> 的最近记录。</p>
      <div class="signal-list">
        {blogItems.length ? blogItems.map((item, index) => (
          <a href={item.href} target="_blank" rel="noreferrer" class="signal-item">
            <span>0{index + 1}</span>
            <div>
              <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
              <h3>{item.title}</h3>
            </div>
            <b aria-hidden="true">↗</b>
          </a>
        )) : (
          <div class="signal-empty">
            <span aria-hidden="true">⌁</span>
            <p>信号暂未同步，但博客入口始终开放。</p>
          </div>
        )}
      </div>
      <a class="primary-link" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">进入完整博客 <span>↗</span></a>
      <small class="panel-source">FEED SOURCE / {blogSource.toUpperCase()}</small>
    </aside>

    <aside class="panel-shell" id="panel-about" data-panel-content="about" aria-labelledby="panel-about-title" aria-hidden="true" tabindex="-1">
      <button class="panel-close" type="button" data-close-panel aria-label="关闭关于面板">CLOSE <span>×</span></button>
      <div class="panel-index">03</div>
      <p class="panel-kicker">POINT OF ORIGIN</p>
      <h2 id="panel-about-title">关于这颗星球</h2>
      <p class="about-statement">你好，我是 <strong>ZheSphere</strong>。</p>
      <p class="panel-lede">这里是我记录技术、创造与想象的坐标原点。保持好奇，持续构建。</p>
      <div class="about-orbit" aria-hidden="true"><i></i><span>ZS</span></div>
      <div class="about-links">
        {siteConfig.socialLinks.map((link, index) => (
          <a href={link.href} target="_blank" rel="noreferrer"><small>0{index + 1}</small>{link.label}<span>↗</span></a>
        ))}
      </div>
    </aside>

    <footer>
      <span>© {publishedYear} ZHESPHERE</span>
      <span>BUILDING QUIETLY IN THE VOID</span>
    </footer>

    <script>
      const panelTriggers = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
      const panels = [...document.querySelectorAll<HTMLElement>("[data-panel-content]")];
      const closeControls = [...document.querySelectorAll<HTMLElement>("[data-close-panel]")];
      const veil = document.querySelector<HTMLElement>(".veil");
      let activeTrigger: HTMLElement | null = null;

      function openPanel(id: string, trigger?: HTMLElement) {
        const panel = panels.find((item) => item.dataset.panelContent === id);
        if (!panel) return;
        closePanel(false);
        activeTrigger = trigger ?? null;
        document.body.classList.add("panel-open");
        veil?.classList.add("is-visible");
        panel.classList.add("is-open");
        panel.setAttribute("aria-hidden", "false");
        trigger?.setAttribute("aria-expanded", "true");
        window.history.replaceState(null, "", `#panel-${id}`);
        window.setTimeout(() => panel.querySelector<HTMLElement>(".panel-close")?.focus({ preventScroll: true }), 80);
      }

      function closePanel(restoreFocus = true) {
        document.body.classList.remove("panel-open");
        veil?.classList.remove("is-visible");
        panels.forEach((panel) => {
          panel.classList.remove("is-open");
          panel.setAttribute("aria-hidden", "true");
        });
        panelTriggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
        if (window.location.hash.startsWith("#panel-")) history.replaceState(null, "", window.location.pathname);
        if (restoreFocus) activeTrigger?.focus();
        activeTrigger = null;
      }

      panelTriggers.forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          const id = trigger.dataset.panel;
          if (!id) return;
          event.preventDefault();
          openPanel(id, trigger);
        });
      });
      closeControls.forEach((control) => control.addEventListener("click", () => closePanel()));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && document.body.classList.contains("panel-open")) closePanel();
      });
      const initialPanel = window.location.hash.match(/^#panel-(blog|about)$/)?.[1];
      if (initialPanel) openPanel(initialPanel);

      const canvas = document.querySelector<HTMLCanvasElement>("#starfield");
      const context = canvas?.getContext("2d", { alpha: true });
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let stars: Array<{ x: number; y: number; size: number; alpha: number; speed: number }> = [];
      let frame = 0;
      let pointerX = 0;
      let pointerY = 0;

      function resizeStars() {
        if (!canvas || !context) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.floor(window.innerWidth * dpr);
        canvas.height = Math.floor(window.innerHeight * dpr);
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = reduceMotion.matches ? 34 : Math.min(110, Math.floor(window.innerWidth * window.innerHeight / 11000));
        stars = Array.from({ length: count }, (_, index) => ({
          x: ((index * 73.31) % 100) / 100 * window.innerWidth,
          y: ((index * index * 19.17 + 17) % 100) / 100 * window.innerHeight,
          size: 0.45 + (index % 5) * 0.22,
          alpha: 0.18 + (index % 7) * 0.08,
          speed: 0.018 + (index % 4) * 0.008
        }));
      }

      function drawStars(time = 0) {
        if (!canvas || !context) return;
        context.clearRect(0, 0, window.innerWidth, window.innerHeight);
        for (const star of stars) {
          const drift = reduceMotion.matches ? 0 : Math.sin(time * star.speed * 0.001 + star.x) * 4;
          context.beginPath();
          context.fillStyle = `rgba(196, 220, 255, ${star.alpha})`;
          context.arc(star.x + drift + pointerX, star.y + pointerY, star.size, 0, Math.PI * 2);
          context.fill();
        }
        if (!reduceMotion.matches) frame = requestAnimationFrame(drawStars);
      }

      window.addEventListener("pointermove", (event) => {
        if (reduceMotion.matches) return;
        pointerX = (event.clientX / window.innerWidth - 0.5) * -6;
        pointerY = (event.clientY / window.innerHeight - 0.5) * -6;
      }, { passive: true });
      window.addEventListener("resize", () => { resizeStars(); drawStars(); }, { passive: true });
      reduceMotion.addEventListener("change", () => {
        cancelAnimationFrame(frame);
        resizeStars();
        drawStars();
      });
      resizeStars();
      drawStars();
    </script>

  </body>
</html>
