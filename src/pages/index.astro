---
import { getBlogItems } from "../lib/blog";
import { siteConfig, validateSiteConfig } from "../data/site";
import "../styles/global.css";

const configErrors = validateSiteConfig(siteConfig);
if (configErrors.length) throw new Error(`Invalid site configuration: ${configErrors.join(", ")}`);

const { items: blogItems, source: blogSource } = await getBlogItems(siteConfig.blogFeedUrl);
const publishedYear = new Date().getFullYear();
const formatDate = (value: string) => {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "最近更新";
  return new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  sameAs: siteConfig.socialLinks.map((link) => link.href),
  description: siteConfig.description
};
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b14" />
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={`${siteConfig.name} · Personal Universe`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={siteConfig.siteUrl} />
    <meta property="og:image" content={`${siteConfig.siteUrl}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} · Personal Universe`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}/og.png`} />
    <link rel="canonical" href={siteConfig.siteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{siteConfig.name} · Personal Universe</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <canvas id="starfield" aria-hidden="true"></canvas>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="返回主页顶部">
        <span class="wordmark-mark" aria-hidden="true"></span>
        <span>ORBITVO <small>／ ZHESPHERE</small></span>
      </a>
      <nav aria-label="主要导航">
        <a href={siteConfig.blogUrl} target="_blank" rel="noreferrer">Blog</a>
        <a href="https://github.com/zhesphere" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span>ZHESPHERE</span> · PERSONAL UNIVERSE</p>
          <h1 id="hero-title"><span>在技术与想象之间，</span><strong>建立自己的宇宙。</strong></h1>
          <p class="hero-lede">这里是 ZheSphere 的个人入口。记录硬件、软件、创造过程，以及仍在路上的好奇心。</p>
          <div class="hero-actions">
            <a class="button button-primary" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">阅读博客 <span>↗</span></a>
            <a class="github-link" href="https://github.com/zhesphere" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
          </div>
        </div>

        <div class="orbit-visual" aria-hidden="true">
          <div class="orbit-glow" aria-hidden="true"></div>
          <div class="orbit-ring ring-outer" aria-hidden="true"><i class="planet planet-cyan"></i></div>
          <div class="orbit-ring ring-middle" aria-hidden="true"><i class="planet planet-violet"></i></div>
          <div class="orbit-ring ring-inner" aria-hidden="true"><i class="planet planet-blue"></i></div>
          <div class="visual-core">
            <span>ORBITVO</span>
          </div>
        </div>
        <a class="explore-cue" href="#writing">继续探索 <span aria-hidden="true">↓</span></a>
      </section>

      <section class="section explore-section" id="explore" aria-labelledby="explore-title">
        <header class="section-heading">
          <div><p class="eyebrow">01 / EXPLORE</p><h2 id="explore-title">从这里开始</h2></div>
          <p>文章、代码与个人介绍，各自拥有清晰而直接的入口。</p>
        </header>
        <div class="portal-grid">
          {siteConfig.portals.map((portal) => (
            <a
              class={`portal-card portal-${portal.id}`}
              href={portal.id === "about" ? "#about" : portal.href ?? siteConfig.blogUrl}
              target={portal.id === "about" ? undefined : "_blank"}
              rel={portal.id === "about" ? undefined : "noreferrer"}
            >
              <span class="portal-index">{portal.index}</span>
              <span class="portal-icon" aria-hidden="true"><i></i></span>
              <span class="portal-text"><small>{portal.eyebrow}</small><strong>{portal.label}</strong><em>{portal.description}</em></span>
              <span class="portal-arrow" aria-hidden="true">{portal.id === "about" ? "↓" : "↗"}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section writing-section" id="writing" aria-labelledby="writing-title">
        <header class="section-heading">
          <div><p class="eyebrow">02 / WRITING</p><h2 id="writing-title">最近记录</h2></div>
          <a class="section-link" href={siteConfig.blogUrl} target="_blank" rel="noreferrer">查看全部文章 <span>↗</span></a>
        </header>
        <div class="article-grid">
          {blogItems.length ? blogItems.map((item, index) => (
            <a class="article-card" href={item.href} target="_blank" rel="noreferrer">
              <span class="article-number">0{index + 1}</span>
              <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
              <h3>{item.title}</h3>
              <span class="article-arrow" aria-hidden="true">↗</span>
            </a>
          )) : (
            <div class="article-empty"><p>最新文章正在穿越星际网络。</p></div>
          )}
        </div>
        <p class="feed-source">FEED SOURCE / {blogSource.toUpperCase()}</p>
      </section>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <div class="about-mark" aria-hidden="true"><span>ZS</span></div>
        <div class="about-copy">
          <p class="eyebrow">03 / POINT OF ORIGIN</p>
          <h2 id="about-title">你好，我是 ZheSphere。</h2>
          <p>一名硬件工程师，也是持续探索软件、设计与 AI 的创造者。这里收集我做过的东西、写下的思考，以及下一次尝试的起点。</p>
          <div class="about-links">
            {siteConfig.socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label}<span>↗</span></a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>© {publishedYear} ZHESPHERE</span>
      <span>BUILDING QUIETLY IN THE VOID</span>
      <a href="#top">回到顶部 ↑</a>
    </footer>

    <script>
      const canvas = document.querySelector<HTMLCanvasElement>("#starfield");
      const context = canvas?.getContext("2d", { alpha: true });
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let stars: Array<{ x: number; y: number; size: number; alpha: number; speed: number }> = [];
      let frame = 0;

      function resizeStars() {
        if (!canvas || !context) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.floor(window.innerWidth * dpr);
        canvas.height = Math.floor(window.innerHeight * dpr);
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = reduceMotion.matches ? 28 : Math.min(72, Math.floor(window.innerWidth * window.innerHeight / 18000));
        stars = Array.from({ length: count }, (_, index) => ({
          x: ((index * 73.31) % 100) / 100 * window.innerWidth,
          y: ((index * index * 19.17 + 17) % 100) / 100 * window.innerHeight,
          size: 0.45 + (index % 4) * 0.2,
          alpha: 0.12 + (index % 6) * 0.055,
          speed: 0.012 + (index % 3) * 0.006
        }));
      }

      function drawStars(time = 0) {
        if (!canvas || !context) return;
        context.clearRect(0, 0, window.innerWidth, window.innerHeight);
        for (const star of stars) {
          const drift = reduceMotion.matches ? 0 : Math.sin(time * star.speed * 0.001 + star.x) * 2;
          context.beginPath();
          context.fillStyle = `rgba(196, 220, 255, ${star.alpha})`;
          context.arc(star.x + drift, star.y, star.size, 0, Math.PI * 2);
          context.fill();
        }
        if (!reduceMotion.matches) frame = requestAnimationFrame(drawStars);
      }

      function restartStars() {
        cancelAnimationFrame(frame);
        resizeStars();
        drawStars();
      }

      window.addEventListener("resize", restartStars, { passive: true });
      reduceMotion.addEventListener("change", restartStars);
      restartStars();
    </script>
  </body>
</html>
